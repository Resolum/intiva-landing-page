---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

  <section
    id="inicio"
    class="relative bg-dark pt-28 pb-20 lg:pt-40 lg:pb-32 overflow-hidden"
  >
  <div
    class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary/20 rounded-full mix-blend-screen filter blur-[100px] animate-blob pointer-events-none"
  >
  </div>
  <div
    class="absolute top-1/2 left-0 -translate-y-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-accent/10 rounded-full mix-blend-screen filter blur-[120px] animate-blob animation-delay-2000 pointer-events-none"
  >
  </div>

  <div class="container-main relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 items-center">
      <div class="max-w-2xl text-center lg:text-left opacity-0 animate-fade-in-up">
        <div class="badge badge-accent mb-6">
          <span class="text-sm font-semibold tracking-wide">{t('hero.badge')}</span>
        </div>

        <h1 class="text-4xl md:text-[56px] lg:text-[64px] font-extrabold text-white leading-tight mb-6 tracking-tight drop-shadow-lg">
          {t('hero.title.1')} <br class="hidden lg:block" />
          <span class="gradient-text-accent">{t('hero.title.2')}</span>
        </h1>

        <p class="text-lg md:text-xl text-white/80 mb-10 max-w-xl mx-auto lg:mx-0 font-medium">
          {t('hero.subtitle.1')} <span class="text-white">{t('hero.subtitle.2')}</span>.
        </p>

        <div class="flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start mb-10">
          <a
            href="https://github.com/Resolum/Intiva-mobile-application/releases/download/v1.1.0/intiva-mobile-v1.1.apk"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary w-full sm:w-auto text-center shadow-[0_0_20px_rgba(205,235,69,0.4)] hover:shadow-[0_0_30px_rgba(205,235,69,0.6)] hover:scale-105"
          >
            {t('hero.btn.download')}
          </a>
          <a href="#como-funciona" class="btn-secondary w-full sm:w-auto text-center">
            {t('hero.btn.how')}
          </a>
        </div>

        <div class="flex items-center gap-3 justify-center lg:justify-start">
          <div class="flex text-accent text-lg">★★★★★</div>
          <p class="text-white/80 text-sm font-medium">Más de 500 familias ya usan Intiva</p>
        </div>
      </div>

      <div class="relative w-full max-w-[320px] mx-auto lg:max-w-none lg:mx-0 flex justify-center mt-12 lg:mt-0 opacity-0 animate-fade-in-up" style="animation-delay: 0.2s;">
        <div class="phone-mockup shadow-2xl shadow-primary/40 transform rotate-2 hover:rotate-0 transition-all duration-500 animate-float">
          <div class="absolute top-0 inset-x-0 h-6 flex justify-center z-20">
            <div class="w-32 h-6 bg-dark rounded-b-2xl"></div>
          </div>

          <div class="absolute inset-0 bg-lightbg pt-10 px-4">
            <div class="flex justify-between items-center mb-6">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold">i</div>
              <div class="w-24 h-4 rounded-full bg-gray-200"></div>
              <div class="w-8 h-8 rounded-full bg-gray-200"></div>
            </div>
            <div class="bg-linear-to-br from-primary to-primary-dark rounded-2xl p-5 text-white mb-6 shadow-xl shadow-primary/30 relative overflow-hidden group">
              <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full mix-blend-overlay filter blur-xl transform translate-x-1/2 -translate-y-1/2"></div>
              <p class="text-xs text-white/80 mb-1 font-medium">{t('hero.mockup.balance')}</p>
              <h3 class="text-3xl font-extrabold mb-4">S/ 4,250.00</h3>
              <div class="flex gap-4">
                <div class="bg-white/10 p-2 rounded-lg flex-1 backdrop-blur-sm border border-white/5">
                  <p class="text-[10px] text-white/70 uppercase tracking-wider mb-1">{t('hero.mockup.income')}</p>
                  <p class="text-sm font-bold text-accent">+ S/ 6,500</p>
                </div>
                <div class="bg-white/10 p-2 rounded-lg flex-1 backdrop-blur-sm border border-white/5">
                  <p class="text-[10px] text-white/70 uppercase tracking-wider mb-1">{t('hero.mockup.expenses')}</p>
                  <p class="text-sm font-bold text-white">- S/ 2,250</p>
                </div>
              </div>
            </div>
            <div class="space-y-4">
              <div class="flex justify-between items-center">
                <h4 class="font-bold text-dark text-sm">{t('hero.mockup.latest')}</h4>
                <span class="text-xs text-primary font-bold cursor-pointer hover:underline">{t('hero.mockup.viewAll')}</span>
              </div>

              <div class="flex items-center gap-3 bg-white p-3 rounded-xl shadow-sm border border-gray-50 hover:shadow-md transition-shadow group cursor-pointer">
                <div class="w-10 h-10 rounded-full bg-accent/20 flex items-center justify-center text-accent group-hover:scale-110 transition-transform">🛒</div>
                <div class="flex-1">
                  <p class="text-sm font-bold text-dark group-hover:text-primary transition-colors">{t('hero.mockup.supermarket')}</p>
                  <p class="text-[10px] text-muted font-medium">{t('hero.mockup.yesterday')}</p>
                </div>
                <p class="text-sm font-bold text-dark">- S/ 320.00</p>
              </div>

              <div class="flex items-center gap-3 bg-white p-3 rounded-xl shadow-sm border border-gray-50 hover:shadow-md transition-shadow group cursor-pointer">
                <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center group-hover:scale-110 transition-transform">⚡</div>
                <div class="flex-1">
                  <p class="text-sm font-bold text-dark group-hover:text-primary transition-colors">{t('hero.mockup.utilities')}</p>
                  <p class="text-[10px] text-muted font-medium">{t('hero.mockup.yesterday')}</p>
                </div>
                <p class="text-sm font-bold text-dark">- S/ 150.00</p>
              </div>
            </div>
          </div>
        </div>
        <div class="absolute -right-8 top-1/4 bg-white p-4 rounded-2xl shadow-xl border border-gray-100 animate-float-delayed flex items-center gap-3 hidden sm:flex">
          <div class="w-8 h-8 rounded-full bg-success/20 flex items-center justify-center text-success">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-bold text-dark">{t('hero.mockup.goalReached')}</p>
            <p class="text-[10px] text-muted">{t('hero.mockup.goalTitle')}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
