---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  isLegal?: boolean;
}

const { isLegal = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-[#0D0B1A] pt-32 pb-12 text-white/60 relative overflow-hidden">
  <div
    class="absolute top-0 left-0 w-full h-px bg-linear-to-r from-transparent via-primary/30 to-transparent"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-16 mb-24 reveal"
    >
      <div class="lg:col-span-2">
        <a href={`/${lang}/`} class="inline-flex items-center gap-3 mb-8 group">
          <div
            class="w-10 h-10 rounded-xl bg-linear-to-br from-primary to-[#433b9c] text-white flex items-center justify-center font-black text-2xl shadow-lg shadow-primary/20 group-hover:scale-110 transition-transform"
          >
            i
          </div>
          <span class="text-2xl font-black text-white tracking-tight"
            >Intiva</span
          >
        </a>
        <p class="mb-8 max-w-sm text-lg leading-relaxed">
          {t('footer.desc')}
        </p>
      </div>

      {!isLegal && (
        <>
          <div class="space-y-8">
            <h4 class="text-white font-bold uppercase tracking-widest text-sm">
              {t('footer.product')}
            </h4>
            <ul class="space-y-4">
              <li>
                <a
                  href={isLegal ? `/${lang}/` : "#funcionalidades"}
                  class="hover:text-accent transition-colors flex items-center gap-2 group"
                >
                  <span
                    class="w-1.5 h-1.5 rounded-full bg-primary opacity-0 group-hover:opacity-100 transition-all"
                  ></span>
                  {t('nav.features')}
                </a>
              </li>
              <li>
                <a
                  href={isLegal ? `/${lang}/` : "#beneficios"}
                  class="hover:text-accent transition-colors flex items-center gap-2 group"
                >
                  <span
                    class="w-1.5 h-1.5 rounded-full bg-primary opacity-0 group-hover:opacity-100 transition-all"
                  ></span>
                  {t('nav.benefits')}
                </a>
              </li>
              <li>
                <a
                  href={isLegal ? `/${lang}/` : "#planes"}
                  class="hover:text-accent transition-colors flex items-center gap-2 group"
                >
                  <span
                    class="w-1.5 h-1.5 rounded-full bg-primary opacity-0 group-hover:opacity-100 transition-all"
                  ></span>
                  {t('nav.pricing')}
                </a>
              </li>
              <li>
                <a
                  href={isLegal ? `/${lang}/` : "#"}
                  class="hover:text-accent transition-colors flex items-center gap-2 group"
                >
                  <span
                    class="w-1.5 h-1.5 rounded-full bg-primary opacity-0 group-hover:opacity-100 transition-all"
                  ></span>
                  {t('cta.btn.dashboard')}
                </a>
              </li>
            </ul>
          </div>

          <div class="space-y-8">
            <h4 class="text-white font-bold uppercase tracking-widest text-sm">
              {t('footer.company')}
            </h4>
            <ul class="space-y-4">
              <li>
                <a
                  href={isLegal ? `/${lang}/` : "#equipo"}
                  class="hover:text-accent transition-colors flex items-center gap-2 group"
                >
                  <span
                    class="w-1.5 h-1.5 rounded-full bg-primary opacity-0 group-hover:opacity-100 transition-all"
                  ></span>
                  {t('footer.about')}
                </a>
              </li>
              <li>
                <a
                  href={isLegal ? `/${lang}/` : "#equipo"}
                  class="hover:text-accent transition-colors flex items-center gap-2 group"
                >
                  <span
                    class="w-1.5 h-1.5 rounded-full bg-primary opacity-0 group-hover:opacity-100 transition-all"
                  ></span>
                  {t('nav.team')}
                </a>
              </li>
              <li>
                <a
                  href={isLegal ? `mailto:contact@intiva.com` : "#"}
                  class="hover:text-accent transition-colors flex items-center gap-2 group"
                >
                  <span
                    class="w-1.5 h-1.5 rounded-full bg-primary opacity-0 group-hover:opacity-100 transition-all"
                  ></span>
                  {t('footer.contact')}
                </a>
              </li>
            </ul>
          </div>
        </>
      )}

      <div class="space-y-8">
        <h4 class="text-white font-bold uppercase tracking-widest text-sm">
          {t('footer.legal')}
        </h4>
        <ul class="space-y-4">
          <li>
            <a
              href={`/${lang}/Terms-service`}
              class="hover:text-accent transition-colors flex items-center gap-2 group"
            >
              <span
                class="w-1.5 h-1.5 rounded-full bg-primary opacity-0 group-hover:opacity-100 transition-all"
              ></span>
              {t('footer.terms')}
            </a>
          </li>
          <li>
            <a
              href={`/${lang}/Privacy`}
              class="hover:text-accent transition-colors flex items-center gap-2 group"
            >
              <span
                class="w-1.5 h-1.5 rounded-full bg-primary opacity-0 group-hover:opacity-100 transition-all"
              ></span>
              {t('footer.privacy')}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="pt-12 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-8 reveal"
    >
      <div class="flex flex-col items-center md:items-start gap-2">
        <p class="text-sm">{t('footer.rights')}</p>
      </div>
    </div>
  </div>
</footer>
