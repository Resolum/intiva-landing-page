---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

import newExpenseEs from '../assets/new-expense-es.png';
import limitsEns from '../assets/limits-es.png';
import goalsEs from '../assets/goals-es.png';
import familyEs from '../assets/family-es.png';

import newExpenseEn from '../assets/new-expense-en.png';
import limitsEn from '../assets/limits-en.png';
import goalsEn from '../assets/goals-en.png';
import familyEn from '../assets/family-en.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const features = [
  {
    title: t('features.1.title'),
    image: lang == 'en' ? newExpenseEn : newExpenseEs,
    description: t('features.1.desc'),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
    imageReversed: false,
    mockupColor: "bg-linear-to-br from-[#f8fafc] to-[#e2e8f0]",
    accentClass: "text-[#3b82f6] bg-[#eff6ff]"
  },
  {
    title: t('features.2.title'),
    image: lang == 'en' ? limitsEn : limitsEns,
    description: t('features.2.desc'),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`,
    imageReversed: true,
    mockupColor: "bg-linear-to-br from-[#fff1f2] to-[#ffe4e6]",
    accentClass: "text-[#e11d48] bg-[#fff1f2]"
  },
  {
    title: t('features.3.title'),
    image: lang == 'en' ? goalsEn : goalsEs,
    description: t('features.3.desc'),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>`,
    imageReversed: false,
    mockupColor: "bg-linear-to-br from-[#f0fdf4] to-[#dcfce7]",
    accentClass: "text-[#16a34a] bg-[#f0fdf4]"
  },
  {
    title: t('features.4.title'),
    image: lang == 'en' ? familyEn : familyEs,
    description: t('features.4.desc'),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>`,
    imageReversed: true,
    mockupColor: "bg-linear-to-br from-[#faf5ff] to-[#f3e8ff]",
    accentClass: "text-[#9333ea] bg-[#faf5ff]"
  }
];
---

<section id="funcionalidades" class="py-32 bg-lightbg relative overflow-hidden">
  <div class="absolute top-1/4 left-0 w-72 h-72 bg-primary/5 rounded-full mix-blend-multiply filter blur-3xl animate-blob"></div>
  <div class="absolute bottom-1/4 right-0 w-96 h-96 bg-accent/10 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-2000"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-24 reveal">
      <span class="text-primary font-bold tracking-wider uppercase text-sm mb-4 inline-flex items-center gap-2 bg-primary/5 px-4 py-1.5 rounded-full">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        {t('features.badge')}
      </span>
      <h2 class="text-4xl md:text-5xl font-extrabold text-dark mb-6 tracking-tight">
        {t('features.title.1')} <span class="text-transparent bg-clip-text bg-linear-to-r from-primary to-[#8b83ec]">{t('features.title.2')}</span>
      </h2>
    </div>

    <div class="space-y-32">
      {features.map((feature, index) => (
        <div class={`reveal flex flex-col lg:flex-row items-center gap-12 lg:gap-24 ${feature.imageReversed ? 'lg:flex-row-reverse' : ''}`}>
          
          <div class="w-full lg:w-1/2 flex justify-center perspective-1000">
            <div class={`relative w-[250px] h-[520px] sm:w-[260px] sm:h-[5 60px] md:w-[280px] md:h-[600px] lg:w-[300px] lg:h-[640px] rounded-[40px] border-8 border-dark overflow-hidden bg-white`}>              <!-- Notch -->
              <div class="absolute top-0 inset-x-0 h-6 flex justify-center z-20">
                <div class="w-28 h-5 bg-dark rounded-b-2xl shadow-sm"></div>
              </div>
              
                  <img src={feature.image?.src} alt="App Screen" class="w-full h-full object-cover object-top"/>
              
              <div class="absolute inset-0 bg-linear-to-t from-black/10 to-transparent opacity-0 hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
            </div>
          </div>

          <div class="w-full lg:w-1/2 lg:px-8">
            <div class={`w-14 h-14 rounded-2xl flex items-center justify-center mb-6 shadow-sm ${feature.accentClass}`}>
              <Fragment set:html={feature.icon} />
            </div>
            <h3 class="text-3xl md:text-4xl font-extrabold text-dark mb-5 tracking-tight">{feature.title}</h3>
            <p class="text-lg md:text-xl text-muted mb-8 leading-relaxed">
              {feature.description}
            </p>
            <a href="#" class="inline-flex items-center gap-2 text-primary font-bold hover:text-dark transition-colors group">
              {t('features.explore')}
              <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </div>
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
