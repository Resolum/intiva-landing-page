---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-32 bg-white relative overflow-hidden">
  <div
    class="absolute top-0 right-0 w-full h-1/2 bg-linear-to-b from-lightbg to-transparent pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20 reveal">
      <span
        class="text-primary font-bold tracking-wider uppercase text-sm mb-4 inline-flex items-center gap-2 bg-primary/5 px-4 py-1.5 rounded-full"
      >
        {t('problem.badge')}
      </span>
      <h2
        class="text-4xl md:text-5xl font-extrabold text-dark mb-6 tracking-tight"
      >
        {t('problem.title.1')} <span class="text-primary"
          >{t('problem.title.2')}</span
        >
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div
        class="bg-white rounded-4xl p-8 border border-gray-100 shadow-[0_10px_40px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_50px_rgba(83,74,183,0.1)] hover:-translate-y-2 transition-all duration-300 reveal group relative overflow-hidden"
      >
        <div
          class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full filter blur-2xl group-hover:bg-primary/10 transition-colors"
        >
        </div>
        <div
          class="w-16 h-16 bg-primary/10 rounded-2xl flex items-center justify-center text-primary mb-8 group-hover:scale-110 transition-transform duration-300 relative z-10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-8 h-8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"
            ></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-dark mb-4 relative z-10">
          {t('problem.1.title')}
        </h3>
        <p class="text-muted leading-relaxed font-medium relative z-10">
          {t('problem.1.desc')}
        </p>
      </div>

      <div
        class="bg-white rounded-4xl p-8 border border-gray-100 shadow-[0_10px_40px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_50px_rgba(239,159,39,0.15)] hover:-translate-y-2 transition-all duration-300 reveal group relative overflow-hidden"
        style="transition-delay: 100ms;"
      >
        <div
          class="absolute top-0 right-0 w-32 h-32 bg-warning/5 rounded-full filter blur-2xl group-hover:bg-warning/10 transition-colors"
        >
        </div>
        <div
          class="w-16 h-16 bg-warning/10 rounded-2xl flex items-center justify-center text-warning mb-8 group-hover:scale-110 transition-transform duration-300 relative z-10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-8 h-8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"
            ></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18"
            ></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-dark mb-4 relative z-10">
          {t('problem.2.title')}
        </h3>
        <p class="text-muted leading-relaxed font-medium relative z-10">
          {t('problem.2.desc')}
        </p>
      </div>

      <div
        class="bg-white rounded-4xl p-8 border border-gray-100 shadow-[0_10px_40px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_50px_rgba(29,158,117,0.15)] hover:-translate-y-2 transition-all duration-300 reveal group relative overflow-hidden"
        style="transition-delay: 200ms;"
      >
        <div
          class="absolute top-0 right-0 w-32 h-32 bg-success/5 rounded-full filter blur-2xl group-hover:bg-success/10 transition-colors"
        >
        </div>
        <div
          class="w-16 h-16 bg-success/10 rounded-2xl flex items-center justify-center text-success mb-8 group-hover:scale-110 transition-transform duration-300 relative z-10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-8 h-8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"
            ></path>
            <line
              x1="4"
              y1="4"
              x2="20"
              y2="20"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></line>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-dark mb-4 relative z-10">
          {t('problem.3.title')}
        </h3>
        <p class="text-muted leading-relaxed font-medium relative z-10">
          {t('problem.3.desc')}
        </p>
      </div>
    </div>

    <div class="mt-20 flex flex-col items-center justify-center reveal">
      <div
        class="h-20 w-px bg-linear-to-b from-transparent via-primary/50 to-primary mb-6"
      >
      </div>
      <div
        class="inline-flex items-center gap-3 px-6 py-3 rounded-full bg-linear-to-r from-dark to-[#1a1730] text-accent font-bold shadow-xl shadow-primary/10"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2.5"
          stroke="currentColor"
          class="w-5 h-5 animate-bounce"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3"></path>
        </svg>
        {t('problem.resolved')}
      </div>
    </div>
  </div>
</section>
