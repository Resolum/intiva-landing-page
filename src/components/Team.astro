---
import img1 from "../assets/integrante-1.png";
import img2 from "../assets/integrante-2.png";
import img3 from "../assets/integrante-3.png";
import img4 from "../assets/integrante-4.png";
import img5 from "../assets/integrante-5.png";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const team = [
  {
    name: "Coronel Espinoza Farid Sebastian",
    code: "u202214567",
    roleKey: "team.role.1",
    color: "bg-blue-100 text-blue-600 border-blue-200",
    image: img1,
  },
  {
    name: "Diaz Quispe Matias Sebastian",
    code: "u202315891",
    roleKey: "team.role.2",
    color: "bg-green-100 text-green-600 border-green-200",
    image: img3,
  },
  {
    name: "Juarez Leon Nicolas Emilio Walter",
    code: "u202112345",
    roleKey: "team.role.3",
    color: "bg-purple-100 text-purple-600 border-purple-200",
    image: img2,
  },
  {
    name: "Meza Solórzano Didier Sebastian",
    code: "u202220192",
    roleKey: "team.role.4",
    color: "bg-orange-100 text-orange-600 border-orange-200",
    image: img4,
  },
  {
    name: "Torres Apolinario Giovany Smith",
    code: "u202118745",
    roleKey: "team.role.5",
    color: "bg-teal-100 text-teal-600 border-teal-200",
    image: img5,
  },
];
---

<section id={t("section.team")} class="section-padding bg-white relative overflow-hidden">
  <div class="absolute top-0 right-0 w-full h-px bg-linear-to-r from-transparent via-gray-200 to-transparent"></div>
  <div class="sphere-3d absolute top-32 left-[8%] w-16 h-16 opacity-10 animate-float-slow pointer-events-none" style="background: radial-gradient(circle at 30% 25%, var(--color-accent), var(--color-accent-dark));"></div>
  <div class="coin-3d absolute bottom-20 right-[12%] w-10 h-10 opacity-10 animate-float pointer-events-none"></div>

  <div class="container-main relative z-10">
    <div class="text-center max-w-4xl mx-auto mb-20 reveal">
      <span class="badge badge-primary">{t("team.badge")}</span>
      <h2 class="section-title mt-4">{t("team.title")}</h2>
      <p class="section-subtitle">{t("team.subtitle")}</p>
      <div class="mt-8 flex justify-center">
        <iframe 
          class="w-full max-w-2xl aspect-video rounded-xl shadow-lg"
          src="https://www.youtube.com/embed/Bxic0RN8xBQ"
          title="Intiva Presentation"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8">
      {team.map((member, index) => (
      <div class="flex flex-col items-center text-center reveal group card-hover p-6" style={`transition-delay: ${index * 100}ms;`}>
        <div class={`w-24 h-24 rounded-2xl flex items-center justify-center overflow-hidden mb-6 shadow-sm border group-hover:scale-110 transition-transform duration-300 ${member.color}`}>
          {member.image ? (
            <img src={member.image.src} alt={member.name} class="w-full h-full object-cover" />
          ) : (
            <span class="text-3xl font-black">{member.name.charAt(0)}</span>
          )}
        </div>
        <h3 class="text-base font-bold text-dark mb-1 leading-tight group-hover:text-primary transition-colors">
          {member.name}
        </h3>
        <p class="text-sm font-medium text-primary mb-3">{t(member.roleKey as any)}</p>
        <span class="text-xs text-muted font-mono">{member.code}</span>
      </div>
      ))}
    </div>
  </div>
</section>
