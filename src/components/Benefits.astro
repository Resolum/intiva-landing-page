---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const benefits = [
  {
    title: t('benefits.1.title'),
    desc: t('benefits.1.desc'),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>`,
    colorClass: 'text-primary bg-primary/10 group-hover:shadow-[0_0_30px_rgba(83,74,183,0.3)]',
    bgClass: 'bg-primary/5 group-hover:bg-primary/10'
  },
  {
    title: t('benefits.2.title'),
    desc: t('benefits.2.desc'),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M15 15.9722C15 17.6443 13.6569 19 12 19C10.3431 19 9 17.6443 9 15.9722C9 14.3001 10.3431 12.9444 12 12.9444C13.6569 12.9444 15 14.3001 15 15.9722ZM15 15.9722V15.9722C15 13.914 16.669 12.2477 18.7303 12.2447C19.9868 12.2428 21 11.2227 21 9.9662C21 8.70974 19.9868 7.68962 18.7303 7.68771C16.669 7.68472 15 6.01844 15 3.96023V3.96023C15 2.30225 13.6569 0.957947 12 0.957947C10.3431 0.957947 9 2.30225 9 3.96023V3.96023C9 6.01844 7.33096 7.68472 5.26966 7.68771C4.01319 7.68962 3 8.70974 3 9.9662C3 11.2227 4.01319 12.2428 5.26966 12.2447C7.33096 12.2477 9 13.914 9 15.9722V15.9722" /></svg>`,
    colorClass: 'text-accent bg-accent/20 group-hover:shadow-[0_0_30px_rgba(205,235,69,0.3)] text-[#3f4a0a]',
    bgClass: 'bg-accent/5 group-hover:bg-accent/10'
  },
  {
    title: t('benefits.3.title'),
    desc: t('benefits.3.desc'),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>`,
    colorClass: 'text-primary bg-primary/10 group-hover:shadow-[0_0_30px_rgba(83,74,183,0.3)]',
    bgClass: 'bg-primary/5 group-hover:bg-primary/10'
  },
  {
    title: t('benefits.4.title'),
    desc: t('benefits.4.desc'),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>`,
    colorClass: 'text-accent bg-accent/20 group-hover:shadow-[0_0_30px_rgba(205,235,69,0.3)] text-[#3f4a0a]',
    bgClass: 'bg-accent/5 group-hover:bg-accent/10'
  },
  {
    title: t('benefits.5.title'),
    desc: t('benefits.5.desc'),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" /></svg>`,
    colorClass: 'text-primary bg-primary/10 group-hover:shadow-[0_0_30px_rgba(83,74,183,0.3)]',
    bgClass: 'bg-primary/5 group-hover:bg-primary/10'
  },
  {
    title: t('benefits.6.title'),
    desc: t('benefits.6.desc'),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.829 1.58-1.995 1.09-.196 2.148-.48 3.167-.841 1.037-.369 1.603-1.464 1.25-2.527a11.968 11.968 0 0 0-4.004-5.32 12.012 12.012 0 0 0-7.85-2.023 11.966 11.966 0 0 0-4.004 5.32c-.353 1.063.213 2.158 1.25 2.527 1.019.361 2.077.645 3.167.841.922.166 1.58 1.012 1.58 1.995v.192" /></svg>`,
    colorClass: 'text-accent bg-accent/20 group-hover:shadow-[0_0_30px_rgba(205,235,69,0.3)] text-[#3f4a0a]',
    bgClass: 'bg-accent/5 group-hover:bg-accent/10'
  }
];
---

<section id={t("section.benefits")} class="section-padding bg-white relative overflow-hidden">
  <div class="container-main relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20 reveal">
      <span class="badge badge-primary">{t('benefits.badge')}</span>
      <h2 class="section-title mt-4">{t('benefits.title')}</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {benefits.map((benefit, index) => (
        <div class="card-hover p-8 reveal group relative overflow-hidden" style={`transition-delay: ${index * 100}ms;`}>
          <div class={`absolute top-0 right-0 w-32 h-32 rounded-full filter blur-2xl transition-colors ${benefit.bgClass}`}></div>
          <div class={`w-16 h-16 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-all duration-300 relative z-10 ${benefit.colorClass}`} set:html={benefit.icon}>
          </div>
          <h3 class="text-xl font-bold text-dark mb-4 relative z-10">
            {benefit.title}
          </h3>
          <p class="text-muted leading-relaxed font-medium relative z-10">
            {benefit.desc}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-16 text-center reveal">
      <a href="https://play.google.com/store/apps/details?id=com.resolum.intiva" target="_blank" rel="noopener noreferrer" class="btn-primary rounded-xl shadow-[0_0_20px_rgba(205,235,69,0.3)] hover:shadow-[0_0_30px_rgba(205,235,69,0.5)]">
        {t('benefits.btn')}
      </a>
    </div>
  </div>
</section>
