---
import LanguagePicker from "./LanguagePicker.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  hideNavLinks?: boolean;
}

const { hideNavLinks = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header
  id="navbar"
  class="fixed top-0 left-0 w-full z-50 transition-all duration-300 py-4 bg-transparent"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8 flex items-center justify-between">
    <a href={`/${lang}/`} class="flex items-center gap-2">
      <div
        class="w-8 h-8 rounded-lg bg-primary text-white flex items-center justify-center font-bold text-xl leading-none"
      >
        i
      </div>
      <span
        class="text-xl font-bold text-white transition-colors duration-300"
        id="logo-text">Intiva</span
      >
    </a>

    {!hideNavLinks && (
    <nav class="hidden md:flex items-center gap-8">
      <a
        href="#inicio"
        class="text-sm font-medium text-white/80 hover:text-accent transition-colors nav-link"
        >{t("nav.home")}</a
      >
      <a
        href="#funcionalidades"
        class="text-sm font-medium text-white/80 hover:text-accent transition-colors nav-link"
        >{t("nav.features")}</a
      >
      <a
        href="#beneficios"
        class="text-sm font-medium text-white/80 hover:text-accent transition-colors nav-link"
        >{t("nav.benefits")}</a
      >
      <a
        href="#como-funciona"
        class="text-sm font-medium text-white/80 hover:text-accent transition-colors nav-link"
        >{t("nav.howItWorks")}</a
      >
      <a
        href="#planes"
        class="text-sm font-medium text-white/80 hover:text-accent transition-colors nav-link"
        >{t("nav.pricing")}</a
      >
      <a
        href="#equipo"
        class="text-sm font-medium text-white/80 hover:text-accent transition-colors nav-link"
        >{t("nav.team")}</a
      >
      <a
        href="#testimonios"
        class="text-sm font-medium text-white/80 hover:text-accent transition-colors nav-link"
        >{t("nav.testimonials")}</a
      >
    </nav>
    )}

    <div class="hidden md:flex items-center gap-4">
      <LanguagePicker />
      {!hideNavLinks && (
        <>
          <a
            href="https://intiva-web-application.vercel.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold text-white hover:text-accent transition-colors nav-link nav-link-login"
            >{t("nav.login")}</a
          >
          <a
            href="https://github.com/Resolum/Intiva-mobile-application/releases/download/v1.1.0/intiva-mobile-v1.1.apk"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-accent text-dark px-5 py-2.5 rounded-full text-sm font-semibold hover:bg-[#b8d43c] transition-colors shadow-sm"
          >
            {t("nav.downloadApp")}
          </a>
        </>
      )}
    </div>

    <div class="flex items-center gap-4 md:hidden">
      <LanguagePicker />
      <button id="mobile-menu-btn" class="text-white p-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-6 h-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="fixed inset-0 bg-dark z-40 flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-opacity duration-300"
  >
    <button id="close-menu-btn" class="absolute top-6 right-6 text-white p-2">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-8 h-8"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <a href="#inicio" class="text-2xl font-bold text-white mobile-link"
      >{t("nav.home")}</a
    >
    <a href="#funcionalidades" class="text-2xl font-bold text-white mobile-link"
      >{t("nav.features")}</a
    >
    <a href="#beneficios" class="text-2xl font-bold text-white mobile-link"
      >{t("nav.benefits")}</a
    >
    <a href="#como-funciona" class="text-2xl font-bold text-white mobile-link"
      >{t("nav.howItWorks")}</a
    >
    <a href="#planes" class="text-2xl font-bold text-white mobile-link"
      >{t("nav.pricing")}</a
    >
    <a href="#equipo" class="text-2xl font-bold text-white mobile-link"
      >{t("nav.team")}</a
    >
    <a href="#testimonios" class="text-2xl font-bold text-white mobile-link"
      >{t("nav.testimonials")}</a
    >
    <div class="flex flex-col items-center gap-4 mt-8">
      <a href="https://intiva-web-application.vercel.app/" target="_blank" rel="noopener noreferrer" class="text-lg font-semibold text-white">{t("nav.login")}</a>
      <a
        href="https://github.com/Resolum/Intiva-mobile-application/releases/download/v1.1.0/intiva-mobile-v1.1.apk"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-accent text-dark px-8 py-3 rounded-full text-lg font-semibold"
        >{t("nav.downloadApp")}</a
      >
    </div>
  </div>
</header>

<script>
  const navbar = document.getElementById("navbar");
  const logoText = document.getElementById("logo-text");
  const navLinks = document.querySelectorAll(".nav-link:not(.nav-link-login)");
  const loginLink = document.querySelector(".nav-link-login");
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const closeMenuBtn = document.getElementById("close-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      navbar?.classList.remove("bg-transparent", "py-4");
      navbar?.classList.add("bg-white", "py-3", "shadow-sm");
      logoText?.classList.replace("text-white", "text-primary");
      mobileMenuBtn?.classList.replace("text-white", "text-dark");
      navLinks.forEach((link) => {
        link.classList.remove("text-white/80", "hover:text-accent");
        link.classList.add("text-muted", "hover:text-primary");
      });
      if (loginLink) {
        loginLink.classList.remove("text-white", "hover:text-accent");
        loginLink.classList.add("text-dark", "hover:text-primary");
      }
    } else {
      navbar?.classList.add("bg-transparent", "py-4");
      navbar?.classList.remove("bg-white", "py-3", "shadow-sm");
      logoText?.classList.replace("text-primary", "text-white");
      mobileMenuBtn?.classList.replace("text-dark", "text-white");
      navLinks.forEach((link) => {
        link.classList.add("text-white/80", "hover:text-accent");
        link.classList.remove("text-muted", "hover:text-primary");
      });
      if (loginLink) {
        loginLink.classList.add("text-white", "hover:text-accent");
        loginLink.classList.remove("text-dark", "hover:text-primary");
      }
    }
  });

  const toggleMenu = () => {
    const isClosed = mobileMenu?.classList.contains("opacity-0");
    if (isClosed) {
      mobileMenu?.classList.remove("opacity-0", "pointer-events-none");
      document.body.style.overflow = "hidden";
    } else {
      mobileMenu?.classList.add("opacity-0", "pointer-events-none");
      document.body.style.overflow = "";
    }
  };

  mobileMenuBtn?.addEventListener("click", toggleMenu);
  closeMenuBtn?.addEventListener("click", toggleMenu);
  mobileLinks.forEach((link) => link.addEventListener("click", toggleMenu));
</script>
