---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="planes" class="section-padding bg-lightbg relative overflow-hidden">
  <div class="absolute top-0 right-0 w-1/2 h-1/2 bg-primary/5 rounded-bl-[100%] pointer-events-none"></div>

  <div class="container-main relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20 reveal">
      <span class="badge badge-primary">{t('plans.badge')}</span>
      <h2 class="section-title mt-4">{t('plans.title')}</h2>
      <p class="section-subtitle">{t('plans.subtitle')}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto items-stretch">
      <div class="card-hover p-8 reveal group">
        <h3 class="text-2xl font-bold text-dark mb-2">{t('plans.free.title')}</h3>
        <div class="mb-6">
          <span class="text-5xl font-extrabold text-dark">S/ 0</span>
          <span class="text-muted font-medium">{t('plans.month')}</span>
        </div>
        <a href="https://play.google.com/store/apps/details?id=com.resolum.intiva" target="_blank" rel="noopener noreferrer" class="block w-full py-4 px-4 rounded-xl border-2 border-primary text-primary font-bold text-center hover:bg-primary/5 transition-all mb-8 focus-visible:outline-2 focus-visible:outline-primary">
          {t('plans.free.btn')}
        </a>
        <ul class="space-y-4">
          {['1','2','3'].map((i) => (
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-success shrink-0"><path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z" clip-rule="evenodd" /></svg>
            <span class="text-dark/80 font-medium">{t(`plans.free.${i}`)}</span>
          </li>
          ))}
          {['4','5'].map((i) => (
          <li class="flex items-start gap-3 opacity-40">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 shrink-0"><path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 011.06 0L12 10.94l5.47-5.47a.75.75 0 111.06 1.06L13.06 12l5.47 5.47a.75.75 0 11-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 01-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 010-1.06z" clip-rule="evenodd" /></svg>
            <span class="text-dark/80">{t(`plans.free.${i}`)}</span>
          </li>
          ))}
        </ul>
      </div>

      <div class="card-hover p-8 border-2 border-accent shadow-lg relative transform md:-translate-y-4 reveal group" style="transition-delay: 150ms;">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-accent text-dark px-6 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest shadow-lg shadow-accent/20">
          {t('plans.popular')}
        </div>
        <h3 class="text-2xl font-bold text-dark mb-2">{t('plans.premium.title')}</h3>
        <div class="mb-6">
          <span class="text-5xl font-extrabold text-dark">S/ 14.90</span>
          <span class="text-muted font-medium">{t('plans.month')}</span>
        </div>
        <a href="https://play.google.com/store/apps/details?id=com.resolum.intiva" target="_blank" rel="noopener noreferrer" class="block w-full py-4 px-4 rounded-xl bg-accent text-dark font-bold text-center hover:bg-accent-dark hover:scale-[1.02] transition-all mb-2 shadow-[0_0_20px_rgba(205,235,69,0.3)] focus-visible:outline-2 focus-visible:outline-accent">
          {t('plans.premium.btn')}
        </a>
        <p class="text-xs text-muted text-center flex items-center justify-center gap-1 mb-8">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3"><path d="M4.5 3.324v17.352c0 .59.436 1.096 1.024 1.15.545.05.992-.224 1.258-.654l7.143-11.536L4.5 3.324Zm14.28 7.5l-6.074 3.797 7.042-11.37a1.08 1.08 0 0 1 .536.88v12.738a1.08 1.08 0 0 1-.536.88l-7.042-11.371 6.074-3.796Z" /></svg>
          {t('plans.premium.note')}
        </p>
        <ul class="space-y-4">
          {['1','2','3','4','5'].map((i) => (
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-primary shrink-0"><path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z" clip-rule="evenodd" /></svg>
            <span class="text-dark/80 font-medium">{t(`plans.premium.${i}`)}</span>
          </li>
          ))}
        </ul>
      </div>
    </div>
    
    <div class="mt-16 text-center flex flex-col items-center justify-center gap-2 reveal">
      <div class="flex items-center gap-2 bg-gray-100 px-4 py-2 rounded-full border border-gray-200">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-dark"><path d="M4.5 3.324v17.352c0 .59.436 1.096 1.024 1.15.545.05.992-.224 1.258-.654l7.143-11.536L4.5 3.324Zm14.28 7.5l-6.074 3.797 7.042-11.37a1.08 1.08 0 0 1 .536.88v12.738a1.08 1.08 0 0 1-.536.88l-7.042-11.371 6.074-3.796Z" /></svg>
        <span class="text-sm font-medium text-dark">{t('plans.googlePlay')}</span>
      </div>
    </div>
  </div>
</section>
