---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="planes" class="py-32 bg-lightbg relative overflow-hidden">
  <div
    class="absolute top-0 right-0 w-1/2 h-1/2 bg-primary/5 rounded-bl-[100%] pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20 reveal">
      <span
        class="text-primary font-bold tracking-wider uppercase text-sm mb-4 block"
        >{t('plans.badge')}</span
      >
      <h2
        class="text-4xl md:text-5xl font-extrabold text-dark mb-4 tracking-tight"
      >
        {t('plans.title')}
      </h2>
      <p class="text-lg md:text-xl text-muted font-medium">
        {t('plans.subtitle')}
      </p>
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto items-center"
    >
      <div
        class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 reveal group"
      >
        <h3 class="text-2xl font-bold text-dark mb-2">{t('plans.free.title')}</h3>
        <div class="mb-6">
          <span class="text-5xl font-extrabold text-dark">S/ 0</span>
          <span class="text-muted font-medium">{t('plans.month')}</span>
        </div>
        <a
          href="#"
          class="block w-full py-4 px-4 rounded-xl border-2 border-gray-100 text-dark font-bold text-center group-hover:border-primary group-hover:text-primary transition-all mb-8"
        >
          {t('plans.free.btn')}
        </a>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5 text-success shrink-0"
              ><path
                fill-rule="evenodd"
                d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z"
                clip-rule="evenodd"></path></svg
            >
            <span class="text-dark/80 font-medium"
              >{t('plans.free.1')}</span
            >
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5 text-success shrink-0"
              ><path
                fill-rule="evenodd"
                d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z"
                clip-rule="evenodd"></path></svg
            >
            <span class="text-dark/80 font-medium"
              >{t('plans.free.2')}</span
            >
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5 text-success shrink-0"
              ><path
                fill-rule="evenodd"
                d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z"
                clip-rule="evenodd"></path></svg
            >
            <span class="text-dark/80 font-medium">{t('plans.free.3')}</span>
          </li>
          <li class="flex items-start gap-3 opacity-40">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5 shrink-0"
              ><path
                fill-rule="evenodd"
                d="M5.47 5.47a.75.75 0 011.06 0L12 10.94l5.47-5.47a.75.75 0 111.06 1.06L13.06 12l5.47 5.47a.75.75 0 11-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 01-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 010-1.06z"
                clip-rule="evenodd"></path></svg
            >
            <span class="text-dark/80">{t('plans.free.4')}</span>
          </li>
          <li class="flex items-start gap-3 opacity-40">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5 shrink-0"
              ><path
                fill-rule="evenodd"
                d="M5.47 5.47a.75.75 0 011.06 0L12 10.94l5.47-5.47a.75.75 0 111.06 1.06L13.06 12l5.47 5.47a.75.75 0 11-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 01-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 010-1.06z"
                clip-rule="evenodd"></path></svg
            >
            <span class="text-dark/80">{t('plans.free.5')}</span>
          </li>
        </ul>
      </div>
      <div
        class="bg-linear-to-b from-dark to-[#100e1f] rounded-4xl p-8 border border-white/10 shadow-2xl relative transform md:-translate-y-6 reveal z-10 animate-glow"
        style="transition-delay: 150ms;"
      >
        <div
          class="absolute inset-0 bg-linear-to-br from-accent/10 to-transparent rounded-4xl pointer-events-none"
        >
        </div>
        <div
          class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-accent text-dark px-6 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest shadow-lg shadow-accent/20"
        >
          {t('plans.popular')}
        </div>
        <h3 class="text-2xl font-bold text-white mb-2 relative z-10">
          {t('plans.family.title')}
        </h3>
        <div class="mb-6 relative z-10">
          <span class="text-5xl font-extrabold text-white">S/ 9.90</span>
          <span class="text-white/70 font-medium">{t('plans.month')}</span>
        </div>
        <a
          href="#"
          class="block w-full py-4 px-4 rounded-xl bg-accent text-dark font-bold text-center hover:bg-[#b8d43c] hover:scale-[1.02] transition-all mb-8 shadow-[0_0_20px_rgba(205,235,69,0.3)] relative z-10"
        >
          {t('plans.family.btn')}
        </a>
        <ul class="space-y-4 relative z-10">
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5 text-accent shrink-0"
              ><path
                fill-rule="evenodd"
                d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z"
                clip-rule="evenodd"></path></svg
            >
            <span class="text-white/90 font-medium">{t('plans.family.1')}</span>
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5 text-accent shrink-0"
              ><path
                fill-rule="evenodd"
                d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z"
                clip-rule="evenodd"></path></svg
            >
            <span class="text-white font-bold"
              >{t('plans.family.2')}</span
            >
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5 text-accent shrink-0"
              ><path
                fill-rule="evenodd"
                d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z"
                clip-rule="evenodd"></path></svg
            >
            <span class="text-white/90 font-medium"
              >{t('plans.family.3')}</span
            >
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5 text-accent shrink-0"
              ><path
                fill-rule="evenodd"
                d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z"
                clip-rule="evenodd"></path></svg
            >
            <span class="text-white/90 font-medium">{t('plans.family.4')}</span>
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5 text-accent shrink-0"
              ><path
                fill-rule="evenodd"
                d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z"
                clip-rule="evenodd"></path></svg
            >
            <span class="text-white/90 font-medium">{t('plans.family.5')}</span>
          </li>
        </ul>
      </div>
      <div
        class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 reveal group"
        style="transition-delay: 300ms;"
      >
        <h3 class="text-2xl font-bold text-dark mb-2">{t('plans.premium.title')}</h3>
        <div class="mb-6">
          <span class="text-5xl font-extrabold text-dark">S/ 14.90</span>
          <span class="text-muted font-medium">{t('plans.month')}</span>
        </div>
        <a
          href="#"
          class="block w-full py-4 px-4 rounded-xl bg-primary/10 text-primary font-bold text-center group-hover:bg-primary group-hover:text-white transition-all mb-8 shadow-sm"
        >
          {t('plans.premium.btn')}
        </a>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5 text-primary shrink-0"
              ><path
                fill-rule="evenodd"
                d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z"
                clip-rule="evenodd"></path></svg
            >
            <span class="text-dark/80 font-medium"
              >{t('plans.premium.1')}</span
            >
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5 text-primary shrink-0"
              ><path
                fill-rule="evenodd"
                d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z"
                clip-rule="evenodd"></path></svg
            >
            <span class="text-dark/80 font-medium"
              >{t('plans.premium.2')}</span
            >
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5 text-primary shrink-0"
              ><path
                fill-rule="evenodd"
                d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z"
                clip-rule="evenodd"></path></svg
            >
            <span class="text-dark/80 font-medium"
              >{t('plans.premium.3')}</span
            >
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5 text-primary shrink-0"
              ><path
                fill-rule="evenodd"
                d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z"
                clip-rule="evenodd"></path></svg
            >
            <span class="text-dark/80 font-medium">{t('plans.premium.4')}</span>
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5 text-primary shrink-0"
              ><path
                fill-rule="evenodd"
                d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z"
                clip-rule="evenodd"></path></svg
            >
