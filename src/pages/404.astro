---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t("404.title")}>
  <main class="min-h-[80vh] flex items-center justify-center bg-lightbg px-6">
    <div class="text-center">
      <div
        class="text-[150px] md:text-[200px] font-black text-primary leading-none tracking-tighter drop-shadow-lg mb-4"
      >
        404
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-dark mb-4">
        {t("404.heading")}
      </h1>
      <p class="text-lg text-muted mb-10">{t("404.desc")}</p>
      <a
        href={`/${lang}/`}
        class="inline-block px-10 py-4 rounded-full bg-accent text-dark font-semibold text-lg hover:bg-[#b8d43c] transition-colors shadow-lg"
      >
        {t("404.btn")}
      </a>
    </div>
  </main>
</Layout>
